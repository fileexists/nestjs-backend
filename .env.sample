PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=change-me-to-a-long-random-string
REFRESH_TOKEN_SECRET=change-me-to-another-long-random-string
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d
# Tolleranza (secondi) per il riuso di un refresh token appena ruotato (richieste parallele del
# browser). 0 = ogni riuso e' trattato come furto: revoca la sessione e invalida i token.
REFRESH_REUSE_GRACE_SECONDS=10

# Password: costo bcrypt (default 12, in produzione minimo 10). Gli hash piu' vecchi vengono
# rigenerati in modo trasparente al primo login.
BCRYPT_ROUNDS=12

# Blocco per account dopo tentativi di login falliti (oltre al limite per IP).
# Dopo N errori l'account si blocca per BASE secondi, poi raddoppia a ogni blocco fino a MAX.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_BASE_SECONDS=60
LOGIN_LOCK_MAX_SECONDS=900
# Gli errori piu' vecchi di questa finestra non contano piu'
LOGIN_ATTEMPT_WINDOW_SECONDS=1800

# PostgreSQL — docker-compose defaults shown below
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://nestjs:nestjs_secret@localhost:5432/nestjs_db

# Optional: used by docker-compose to override postgres defaults
POSTGRES_USER=nestjs
POSTGRES_PASSWORD=nestjs_secret
POSTGRES_DB=nestjs_db
POSTGRES_PORT=5432

# CORS — comma-separated list of allowed origins, or * for all
CORS_ORIGIN=http://localhost:3000

# Google OAuth2 — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Frontend: whitelist (separata da virgole) delle origini ammesse. Link nelle email e redirect
# si costruiscono SOLO da qui (nessun redirect aperto). La prima e' quella predefinita.
# In produzione e' obbligatoria e solo https.
FRONTEND_URL=http://localhost:3000

# Email (SMTP). In sviluppo: Mailpit del docker-compose (UI su http://localhost:8025).
# Se l'API gira dentro compose usa SMTP_HOST=mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=Auth <no-reply@localhost>
# Durata del link di verifica email (es. 30m, 24h, 2d)
EMAIL_VERIFICATION_TTL=24h
# Durata del link di reset password
PASSWORD_RESET_TTL=1h

# Migrazioni: applicale con `yarn migration:run`, oppure all'avvio con DB_MIGRATIONS_RUN=true
DB_MIGRATIONS_RUN=false
