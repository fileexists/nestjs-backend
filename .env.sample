PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=change-me-to-a-long-random-string
REFRESH_TOKEN_SECRET=change-me-to-another-long-random-string
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d
# Grace period (seconds) for reusing a refresh token that was just rotated (parallel browser
# requests): inside it, a second use gets the SAME pair of tokens as the first (per instance, kept
# in memory). After it a reuse is treated as theft: the session is revoked and the tokens invalidated.
# 0 = no grace: every second use is theft.
REFRESH_REUSE_GRACE_SECONDS=10

# Passwords: bcrypt cost (default 12, at least 10 in production). Older hashes are
# transparently regenerated at the next login.
BCRYPT_ROUNDS=12

# Per-account lock after failed login attempts (on top of the per-IP limit).
# After N failures the account is locked for BASE seconds, then the lock doubles each time up to MAX.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_BASE_SECONDS=60
LOGIN_LOCK_MAX_SECONDS=900
# Failures older than this window no longer count
LOGIN_ATTEMPT_WINDOW_SECONDS=1800

# PostgreSQL — docker-compose defaults shown below
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://nestjs:nestjs_secret@localhost:5432/nestjs_db

# Optional: used by docker-compose to override postgres defaults
POSTGRES_USER=nestjs
POSTGRES_PASSWORD=nestjs_secret
POSTGRES_DB=nestjs_db
POSTGRES_PORT=5432

# CORS — comma-separated list of allowed origins. In development `*` is accepted; in production
# it is REQUIRED, https only, never `*` (the app will not start otherwise).
CORS_ORIGIN=http://localhost:3000

# API docs at /docs: always on outside production; in production only with SWAGGER_ENABLED=true.
SWAGGER_ENABLED=false

# Number of reverse proxies in front of the app whose X-Forwarded-For is trusted (default 1).
# Use 0 when nothing sits in front of it: otherwise anyone can fake their IP and sidestep the rate limits.
TRUST_PROXY=1

# Google OAuth2 — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Frontend: whitelist (comma-separated) of allowed origins. Email links and redirects
# are built ONLY from here (no open redirect). The first one is the default.
# Required in production, https only.
FRONTEND_URL=http://localhost:3000

# Email (SMTP). In development: Mailpit from docker-compose (UI at http://localhost:8025).
# If the API runs inside compose use SMTP_HOST=mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=Auth <no-reply@localhost>
# How long the email verification link lasts (e.g. 30m, 24h, 2d)
EMAIL_VERIFICATION_TTL=24h
# How long the password reset link lasts
PASSWORD_RESET_TTL=1h

# Migrations: run them with `yarn migration:run` before starting (recommended in staging/production),
# or at startup with DB_MIGRATIONS_RUN=true (single instance only: several would race on the same migration).
DB_MIGRATIONS_RUN=false
